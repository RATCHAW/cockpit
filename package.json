{
  "name": "cockpit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:generate": "pnpm --filter @cockpit/db db:generate",
    "db:migrate": "pnpm --filter @cockpit/db db:migrate",
    "db:studio": "pnpm --filter @cockpit/db db:studio",
    "auth:generate": "pnpm --filter @cockpit/api auth:generate"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  }
}
