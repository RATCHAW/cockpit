{
  "name": "@cockpit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./finance": "./src/shared/finance.ts",
    "./projects": "./src/shared/projects.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "auth:generate": "auth generate --config src/lib/auth.ts --output ../../packages/db/src/schema/auth.ts -y",
    "lint": "eslint .",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@cockpit/db": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.9",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "hono": "^4.13.12",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cockpit/eslint-config": "workspace:*",
    "@cockpit/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "auth": "^1.7.7",
    "eslint": "catalog:",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
