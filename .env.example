# Shared by apps/api and packages/db (loaded from the repo root)
# Host port for the docker-compose Postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://cockpit:cockpit@localhost:5432/cockpit

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app (the web app proxies /api to the API, so this is the web origin)
BETTER_AUTH_URL=http://localhost:5173
WEB_URL=http://localhost:5173
API_PORT=3000

# Resend — leave empty in development to log emails to the console instead
RESEND_API_KEY=
EMAIL_FROM="Cockpit <onboarding@resend.dev>"
