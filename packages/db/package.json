{
  "name": "@cockpit/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./owner": "./src/owner.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file-if-exists=../../.env src/seed/index.ts",
    "db:reset": "tsx --env-file-if-exists=../../.env src/seed/index.ts --reset",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "typecheck": "tsc"
  },
  "dependencies": {
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@cockpit/eslint-config": "workspace:*",
    "@cockpit/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-seed": "^0.3.1",
    "eslint": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
